# All variables are optional. Set them in your shell or your hosting
# provider's environment settings (never commit real values).

# Postgres connection string (e.g. Neon). When unset, the app uses an embedded
# PGLite database locally and `npm run db:migrate` is skipped.
# DATABASE_URL=postgres://user:password@host/db

# Sign-in. "false" disables accounts; progress is then kept in the browser only.
# VITE_AUTH_ENABLED=false

# Required in production when sign-in is enabled.
# BETTER_AUTH_SECRET=generate-a-random-32+-char-string
# BETTER_AUTH_URL=https://your-domain.example

# OAuth client for the Grok sign-in broker (Google / X sign-in).
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Static (GitHub Pages) build only — see README.
# VITE_STATIC_SITE=true
# BASE_PATH=/learnjp/
